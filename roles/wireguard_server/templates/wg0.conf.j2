# Managed by Ansible. Do not edit manually.

[Interface]
Address = {{ wireguard_interface_addresses | join(', ') }}
ListenPort = {{ wireguard_port }}
PrivateKey = {{ wireguard_server_private_key_file.content | b64decode | trim }}
SaveConfig = {{ 'true' if wireguard_save_config | bool else 'false' }}

{% for peer in wireguard_peers %}
# Peer: {{ peer.name }}
[Peer]
PublicKey = {{ wireguard_peer_public_keys[peer.name] }}
AllowedIPs = {{ peer.server_allowed_ips | default(peer.addresses | join(', ')) }}

{% endfor %}
