server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name {{ item.server_name }};

    ssl_certificate     {{ item.ssl_certificate }};
    ssl_certificate_key {{ item.ssl_certificate_key }};

    include snippets/ssl-common.conf;
    include snippets/security-headers.conf;

    client_max_body_size {{ item.client_max_body_size | default(nginx_client_max_body_size) }};

    access_log /var/log/nginx/{{ item.name }}.access.log;
    error_log  /var/log/nginx/{{ item.name }}.error.log warn;

    location / {
        proxy_pass {{ item.backend }};

        include snippets/proxy-common.conf;

{% if item.websocket | default(false) %}
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
{% endif %}
    }
}
