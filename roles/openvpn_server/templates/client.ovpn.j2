client
dev tun
{% for remote_proto in openvpn_remote_protos %}
remote {{ openvpn_remote_host }} {{ openvpn_port }} {{ remote_proto }}
{% endfor %}
resolv-retry infinite
nobind

persist-key
persist-tun

{% if ovpn_client_type == 'gateway' %}
{% for gw_net in ovpn_client_gateway_networks | default([]) %}
# This is the gateway client for {{ gw.net.gateway_network_ip }}, so it needs to ignore
# any route directives that the server may push for that network, since those would
# break connectivity for the local network that the gateway is supposed to be providing access to.
pull-filter ignore "route {{ gw_net.gateway_network_ip }} {{ gw_net.gateway_network_netmask }}"
{% endfor %}

# This is a gateway-client, so it needs to ignore any "redirect-gateway" directives that the
# server may push (these mean "full tunnel VPN"), since that would break connectivity for
# the local network that the gateway is supposed to be providing access to.
pull-filter ignore "redirect-gateway"
{% elif ovpn_client_type == 'local' %}
{% for local_net in ovpn_client_local_ignore_networks | default([]) %}
# This is a local client that may be on {{ local_net.gateway_network_ip }}, so it needs to ignore
# any route directives that the server may push for that network to avoid hairpin routing.
pull-filter ignore "route {{ local_net.gateway_network_ip }} {{ local_net.gateway_network_netmask }}"
{% endfor %}
{% endif %}

remote-cert-tls server
key-direction 1

verb 3

<ca>
{{ ovpn_ca_content }}
</ca>

<cert>
{{ ovpn_crt_content }}
</cert>

<key>
{{ ovpn_key_content }}
</key>

<tls-auth>
{{ ovpn_ta_content }}
</tls-auth>
